# Copy to `.env` and fill in. `.env` is git-ignored.

# Repository root. Input data is resolved as
#   $BASE_DIR/data/$DATA_NAME/{cancer}_dx_1st_seq_OS.csv
# and all results, models and logs are written beneath it.
BASE_DIR="/path/to/survprompt"

# Directory containing input data. Accepted by the baseline and ablation CLIs,
# but note the mskchord loader resolves input paths from BASE_DIR (above), not
# from INPUT_DIR.
INPUT_DIR="/path/to/input/data"

# --- Azure OpenAI -----------------------------------------------------------
# Only needed for the LLM prompting experiments. The Cox/RSF baselines and
# everything under demo/ run without any of these.

AZURE_OPENAI_ENDPOINT="your_endpoint"
AZURE_OPENAI_API_VERSION="your_api_version"

# Authenticate with either an API key...
AZURE_OPENAI_API_KEY="your_api_key"
# ...or Entra ID via the Azure CLI (`az login`), in which case leave the key unset.

# Override the token scope only if your deployment sits behind a gateway that
# exposes its own application ID URI.
AZURE_OPENAI_TOKEN_SCOPE="https://cognitiveservices.azure.com/.default"
